# ==============================================================================
# i4ware Job Seekers Autopilot AI - Interview Assistant Desktop Environment
# ==============================================================================
# DO NOT COMMIT SECRETS OR REAL API KEYS TO VERSION CONTROL.
# Provider API keys (OpenAI, Gemini, LiveAvatar) are maintained on the WordPress server:
# http://localhost/mattikiviharju/wp-admin/admin.php?page=ai-cv-tailor-settings
# ==============================================================================

# WordPress Local REST API base URL
WORDPRESS_SERVER_URL=http://localhost/mattikiviharju

# Loopback communication port for Chrome/Edge meeting assistant extension
LOOPBACK_PORT=41793

# Default answer language ('fi', 'en', 'sv', 'de')
DEFAULT_LANGUAGE=fi

# Operating mode ('job_seeker' or 'hr_advisor')
DEFAULT_MODE=job_seeker

# Audio Recording and Transcription Storage
# Default is strictly false (disabled). Explicit user opt-in required for permanent storage.
ENABLE_PERMANENT_TRANSCRIPTION_STORAGE=false

# LiveAvatar Streaming Configuration (if using WebRTC cloud provider like HeyGen/Simli)
# Leave empty to use local interactive digital human canvas renderer
LIVEAVATAR_PROVIDER=local_canvas
LIVEAVATAR_AVATAR_ID=default_avatar
LIVEAVATAR_VOICE_ID=default_voice
