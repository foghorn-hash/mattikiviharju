# ==============================================================================
# Google Antigravity & Gemini AI Avatar Interview Assistant
# Environment Configuration Template (.env.example)
#
# IMPORTANT: DO NOT COMMIT REAL SECRETS OR SENSITIVE API KEYS TO GIT.
# On production or local WordPress, add GOOGLE_AI_API_KEY to wp-config.php:
# define( 'GOOGLE_AI_API_KEY', 'your-actual-gemini-api-key' );
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Gemini AI Platform Configuration
# ------------------------------------------------------------------------------
# Google AI Studio API key (Keep secure on the server, never expose to client JS)
GOOGLE_AI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Recommended text generation models for low-latency interview answering:
# - gemini-3.5-flash-lite (Fastest, low latency ~1s, separate quota bucket)
# - gemini-3.1-flash-lite (Reliable fallback)
# - gemini-3.5-flash      (Deep multimodal)
# - gemini-3.8-flash      (Advanced reasoning)
GEMINI_TEXT_MODEL=gemini-3.5-flash-lite

# Gemini Text-to-Speech (TTS) models:
# - gemini-3.8-flash-tts      (High-fidelity 24kHz studio audio)
# - gemini-3.8-flash-lite-tts (Ultra-low latency speech synthesis)
GEMINI_TTS_MODEL=gemini-3.8-flash-tts

# Prebuilt voice names: Puck, Kore, Fenrir, Aoede, Zephyr, Orus, Autonoe
GEMINI_TTS_VOICE=Puck

# Default speaking speed (0.85, 1.0, 1.2, 1.4)
GEMINI_TTS_SPEED=1.0

# ------------------------------------------------------------------------------
# 2. WordPress & REST API Configuration
# ------------------------------------------------------------------------------
WORDPRESS_URL=http://localhost/mattikiviharju
WORDPRESS_REST_NAMESPACE=gemini-avatar/v1

# Default UI language: 'fi' (Finnish), 'en' (English), 'sv' (Swedish)
DEFAULT_LANGUAGE=fi

# Default operating mode: 'interview' (1st person job candidate) or 'assistant' (3rd person)
DEFAULT_MODE=interview

# Default response style: 'concise' (~25s), 'conversational' (~45s), 'technical' (~75s)
DEFAULT_STYLE=conversational

# ------------------------------------------------------------------------------
# 3. Microsoft Teams & Google Meet Audio/Video Virtual Routing (Windows 11)
# ------------------------------------------------------------------------------
# Virtual Microphone (routes synthesized avatar speech to Teams/Meet without feedback)
# Recommended driver: VB-Audio Virtual Cable (https://vb-audio.com/Cable/)
AUDIO_VIRTUAL_OUTPUT_DEVICE="CABLE Input (VB-Audio Virtual Cable)"
AUDIO_MEETING_INPUT_DEVICE="CABLE Output (VB-Audio Virtual Cable)"

# Virtual Camera (routes avatar video into Teams/Meet meeting video)
# Options:
# - OBS Virtual Camera (via OBS Studio Window Capture)
# - SpoutCam (DirectShow virtual webcam filter from Spout2)
# - NDI Webcam Input (via NDI Tools)
VIDEO_VIRTUAL_CAMERA="OBS Virtual Camera"

# ------------------------------------------------------------------------------
# 4. TroikaTronix Isadora 3 Integration (Windows 11)
# ------------------------------------------------------------------------------
# Isadora 3 GPU texture sharing technology: Spout (Windows counterpart to Syphon)
ISADORA_SPOUT_ENABLED=true
ISADORA_SPOUT_SENDER_NAME="IsadoraStage1"
ISADORA_SCREEN_CAPTURE_WINDOW_TITLE="LiveAvatar — Matti Kiviharju"
ISADORA_STAGE_RESOLUTION=1920x1080

# ------------------------------------------------------------------------------
# 5. Local Desktop & Browser Companion (Optional)
# ------------------------------------------------------------------------------
LOOPBACK_PORT=41793
ENABLE_PERMANENT_TRANSCRIPTION_STORAGE=false
